{
  "manifest_version": 3,
  "name": "Tabby",
  "version": "0.4.0",
  "description": "A calm tab vault that turns open tabs into searchable, structured memory.",
  "permissions": ["tabs", "storage", "contextMenus", "tabGroups"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabby",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
